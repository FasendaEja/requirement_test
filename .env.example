# ============================================================
# Все параметры утилиты. Значения читаются файлом main.py.
# ============================================================

# --- Доступ к ИИ (OpenAI-совместимый API) ---
# Токен для доступа к ИИ (ОБЯЗАТЕЛЬНО замените на реальный ключ)
OPENAI_API_KEY=sk-ваш-токен-доступа-к-ии
# Путь до API ИИ (base_url OpenAI-совместимого сервиса)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Параметры модели ---
MODEL=qwen3.8
TEMPERATURE=0.1
MAX_TOKENS=200000
TIMEOUT=600
MAX_RETRIES=3
RETRY_DELAY=5
SYSTEM_PROMPT=Ты — опытный аналитик по тестированию требований.

# --- Пути и файлы ---
INPUT_DIR=input
PROMPT_FILE=prompt.txt
OUTPUT_DIR=output
SUPPORTED_EXTENSIONS=doc,docx,md,pdf,txt,xlsx,xml,json

# --- Имя файла результата ---
RESULT_PREFIX=тестирование требований__
OUTPUT_EXTENSION=.md
TIMESTAMP_FORMAT=%Y-%m-%d_%H-%M-%S

# Ограничение на размер текста одного файла в символах (0 = без ограничения)
MAX_FILE_CHARS=0

# --- Mind-map и чек-лист (формируются после завершения тестирования) ---
# Формировать ли mind-map по результатам тестирования (true/false)
GENERATE_MINDMAP=true
# Формировать ли чек-лист проверок (true/false)
GENERATE_CHECKLIST=true
# Файлы промтов для дополнительных запросов к ИИ
MINDMAP_PROMPT_FILE=prompt_mindmap.txt
CHECKLIST_PROMPT_FILE=prompt_checklist.txt
# Имена файлов результатов (префикс + дата_время + расширение)
MINDMAP_PREFIX=майнд-мапа__
MINDMAP_EXTENSION=.md
CHECKLIST_PREFIX=чек-лист__
CHECKLIST_EXTENSION=.csv
